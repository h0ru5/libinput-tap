From 52d0d7a794c87ecbac1992b2456e7178b8ea65a6 Mon Sep 17 00:00:00 2001
From: Johannes Hund <johannes@ecog.io>
Date: Sat, 14 Nov 2026 18:15:35 +0100
Subject: [PATCH] touchpad: add AttrTapMoveThreshold quirk

The maximum distance a finger may move during a tap is hardcoded to
1.3mm. Users whose fingers slide slightly on lift-off, for example
because of motor impairments, see many taps turn into pointer motion.

Add a per-device AttrTapMoveThreshold quirk (mm, > 0) that overrides
the default. Behaviour without the quirk is unchanged.
---
 doc/user/device-quirks.rst  | 4 ++++
 src/evdev-mt-touchpad-tap.c | 9 ++++++++-
 src/evdev-mt-touchpad.h     | 3 +++
 src/quirks.c                | 9 +++++++++
 src/quirks.h                | 1 +
 tools/shared.c              | 1 +
 6 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/doc/user/device-quirks.rst b/doc/user/device-quirks.rst
index e0959a2..ba7a46d 100644
--- a/doc/user/device-quirks.rst
+++ b/doc/user/device-quirks.rst
@@ -176,6 +176,10 @@ AttrTouchSizeRange=N:M, AttrPalmSizeThreshold=O
     details.
     An AttrPalmSizeThreshold of zero unsets any threshold that has been
     inherited from another quirk.
+AttrTapMoveThreshold=N
+    Maximum distance in mm a finger may move during a tap before the touch is
+    no longer considered a tap. Defaults to 1.3. Must be greater than zero.
+    Useful for users whose fingers slide slightly on lift-off.
 AttrPressureRange=N:M, AttrPalmPressureThreshold=O, AttrThumbPressureThreshold=P
     Specifies the touch pressure required to trigger a press (N) and to
     trigger a release (M), when a palm touch is triggered (O) and when a
diff --git a/src/evdev-mt-touchpad-tap.c b/src/evdev-mt-touchpad-tap.c
index 565f291..8a046cd 100644
--- a/src/evdev-mt-touchpad-tap.c
+++ b/src/evdev-mt-touchpad-tap.c
@@ -1207,7 +1207,7 @@ tp_tap_exceeds_motion_threshold(struct tp_dispatch *tp, struct tp_touch *t)
 	if (tp->semi_mt && tp->nfingers_down != tp->old_nfingers_down)
 		return false;
 
-	return length_in_mm(mm) > DEFAULT_TAP_MOVE_THRESHOLD;
+	return length_in_mm(mm) > tp->tap.move_threshold;
 }
 
 static bool
@@ -1591,6 +1591,13 @@ tp_init_tap(struct tp_dispatch *tp)
 
 	struct evdev_device *device = tp->device;
 
+	tp->tap.move_threshold = DEFAULT_TAP_MOVE_THRESHOLD;
+	_unref_(quirks) *q = libinput_device_get_quirks(&device->base);
+	double threshold;
+	if (quirks_get_double(q, QUIRK_ATTR_TAP_MOVE_THRESHOLD, &threshold) &&
+	    threshold > 0.0)
+		tp->tap.move_threshold = threshold;
+
 	const struct input_absinfo *absx = device->abs.absinfo_x;
 	const struct input_absinfo *absy = device->abs.absinfo_y;
 	assert(absx && absy);
diff --git a/src/evdev-mt-touchpad.h b/src/evdev-mt-touchpad.h
index 48375b7..9739231 100644
--- a/src/evdev-mt-touchpad.h
+++ b/src/evdev-mt-touchpad.h
@@ -480,6 +480,9 @@ struct tp_dispatch {
 		struct {
 			int left, right, top, bottom;
 		} edges;
+
+		/* Max movement in mm before a touch stops being a tap */
+		double move_threshold;
 	} tap;
 
 	struct {
diff --git a/src/quirks.c b/src/quirks.c
index 8d03ba6..ccee79a 100644
--- a/src/quirks.c
+++ b/src/quirks.c
@@ -329,6 +329,8 @@ quirk_get_name(enum quirk q)
 		return "AttrTabletSmoothing";
 	case QUIRK_ATTR_THUMB_SIZE_THRESHOLD:
 		return "AttrThumbSizeThreshold";
+	case QUIRK_ATTR_TAP_MOVE_THRESHOLD:
+		return "AttrTapMoveThreshold";
 	case QUIRK_ATTR_MSC_TIMESTAMP:
 		return "AttrMscTimestamp";
 	case QUIRK_ATTR_EVENT_CODE:
@@ -897,6 +899,13 @@ parse_attr(struct quirks_context *ctx,
 		p->type = PT_UINT;
 		p->value.u = v;
 		rc = true;
+	} else if (streq(key, quirk_get_name(QUIRK_ATTR_TAP_MOVE_THRESHOLD))) {
+		p->id = QUIRK_ATTR_TAP_MOVE_THRESHOLD;
+		if (!safe_atod(value, &d) || d <= 0.0)
+			goto out;
+		p->type = PT_DOUBLE;
+		p->value.d = d;
+		rc = true;
 	} else if (streq(key, quirk_get_name(QUIRK_ATTR_MSC_TIMESTAMP))) {
 		p->id = QUIRK_ATTR_MSC_TIMESTAMP;
 		if (!streq(value, "watch"))
diff --git a/src/quirks.h b/src/quirks.h
index 25bb95e..2372c78 100644
--- a/src/quirks.h
+++ b/src/quirks.h
@@ -109,6 +109,7 @@ enum quirk {
 	QUIRK_ATTR_PALM_SIZE_THRESHOLD,
 	QUIRK_ATTR_PRESSURE_RANGE,
 	QUIRK_ATTR_RESOLUTION_HINT,
+	QUIRK_ATTR_TAP_MOVE_THRESHOLD,
 	QUIRK_ATTR_TABLET_SMOOTHING,
 	QUIRK_ATTR_THUMB_PRESSURE_THRESHOLD,
 	QUIRK_ATTR_THUMB_SIZE_THRESHOLD,
diff --git a/tools/shared.c b/tools/shared.c
index f75d21c..04ba597 100644
--- a/tools/shared.c
+++ b/tools/shared.c
@@ -1031,6 +1031,7 @@ tools_list_device_quirks(struct quirks_context *ctx,
 				callback(userdata, buf);
 				break;
 			case QUIRK_ATTR_TRACKPOINT_MULTIPLIER:
+			case QUIRK_ATTR_TAP_MOVE_THRESHOLD:
 				quirks_get_double(quirks, q, &d);
 				snprintf(buf, sizeof(buf), "%s=%0.2f", name, d);
 				callback(userdata, buf);
-- 
